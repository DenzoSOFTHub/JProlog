<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>it.denzosoft</groupId>
    <artifactId>jprolog</artifactId>
    <version>4.6.0</version>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- START_CHANGE: ISS-2025-0628 - wave P6.4: `mvn package` builds a runnable
             target/jprolog.jar (`java -jar target/jprolog.jar file.pl -g main`). JProlog has no
             runtime dependency, so the plain jar is self-contained (the prelude/*.pl resources
             included). -->
        <finalName>jprolog</finalName>
        <!-- END_CHANGE: ISS-2025-0628 -->
        <plugins>
            <!-- START_CHANGE: ISS-2025-0628 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>it.denzosoft.jprolog.PrologCLI</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- END_CHANGE: ISS-2025-0628 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.0.0</version>
                <configuration>
                    <!-- ISS-2025-0628: was it.denzosoft.jprolog.Main, which does not exist -->
                    <mainClass>it.denzosoft.jprolog.PrologCLI</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <id>run-ide</id>
                        <configuration>
                            <mainClass>it.denzosoft.jprolog.editor.PrologIDE</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- START_CHANGE: ISS-2025-0491 - 4.1 wave A: ONE engine, ONE CI leg. The `engine-v2`
         profile (and the `engine-v4`/`engine-legacy` ones before it) are gone with the v2
         MachineSolver: `mvn test` is the whole suite on core.engine.v4, the only engine.
         NOTE: no surefire version is pinned. The Maven-default surefire (2.17 with the Maven 3.9
         of the dev environment, as the build log shows) matches Test*/*Test/*TestCase only, so a
         test class named *Tests is silently skipped. (4.5.0, ISS-2025-0665: BuiltInTests.java, the
         one such class, held 10 never-run duplicates and is deleted.)
         END_CHANGE: ISS-2025-0491 -->
</project>
